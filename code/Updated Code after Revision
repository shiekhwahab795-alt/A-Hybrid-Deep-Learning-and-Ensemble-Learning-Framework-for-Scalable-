        "print(\"\\nMODEL SAVED:\", MODEL_PATH)\n",
        "print(\"PREDICTIONS SAVED:\", PRED_PATH)\n",
        "print(\"TRAINING TIME:\", round(training_time, 2), \"seconds\")\n"
