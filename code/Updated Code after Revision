        "# CELL 4: Load and Inspect Training + External Dataset Schemas\n",
        "\n",
        "import pandas as pd\n",
        "import numpy as np\n",
        "from pathlib import Path\n",
        "\n",
        "def load_sample(folder, max_files=3, rows_per_file=5000):\n",
        "\n",
        "    folder = Path(folder)\n",
        "    files = sorted(folder.rglob(\"*.csv\"))\n",
        "\n",
        "    frames = []\n",
        "\n",
        "    for file in files[:max_files]:\n",
        "\n",
        "        try:\n",
        "            df = pd.read_csv(\n",
        "                file,\n",
        "                nrows=rows_per_file,\n",
        "                low_memory=False,\n",
        "                encoding=\"utf-8\"\n",
        "            )\n",
        "        except Exception:\n",
        "            df = pd.read_csv(\n",
        "                file,\n",
        "                nrows=rows_per_file,\n",
        "                low_memory=False,\n",
        "                encoding=\"latin1\"\n",
        "            )\n",
        "\n",
        "        df.columns = df.columns.astype(str).str.strip()\n",
        "        df[\"_source_file\"] = file.name\n",
        "\n",
        "        frames.append(df)\n",
        "\n",
        "    if not frames:\n",
        "        raise ValueError(f\"No readable CSV files in {folder}\")\n",
        "\n",
        "    return pd.concat(frames, ignore_index=True)\n",
        "\n",
