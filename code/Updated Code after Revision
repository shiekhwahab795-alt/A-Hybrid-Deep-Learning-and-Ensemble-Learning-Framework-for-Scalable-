        "# CELL 16: Final Federated Model Comparison\n",
        "\n",
        "import numpy as np\n",
        "import pandas as pd\n",
        "import torch\n",
        "\n",
        "from sklearn.metrics import confusion_matrix\n",
        "\n",
        "def federated_detailed_evaluation(model, setting):\n",
        "\n",
        "    model.eval()\n",
        "\n",
        "    with torch.no_grad():\n",
        "        outputs = model(X_test_tensor)\n",
        "        predictions = outputs.argmax(dim=1).cpu().numpy()\n",
        "\n",
        "    actual = y_test_tensor.cpu().numpy()\n",
        "\n",
        "    cm = confusion_matrix(actual, predictions, labels=[0, 1])\n",
        "    tn, fp, fn, tp = cm.ravel()\n",
        "\n",
        "    benign_recall = tn / (tn + fp) if (tn + fp) else 0\n",
        "    attack_recall = tp / (tp + fn) if (tp + fn) else 0\n",
        "    fpr = fp / (fp + tn) if (fp + tn) else 0\n",
        "\n",
        "    return {\n",
        "        \"Setting\": setting,\n",
        "        \"TN\": tn,\n",
        "        \"FP\": fp,\n",
        "        \"FN\": fn,\n",
        "        \"TP\": tp,\n",
        "        \"Benign_Recall\": benign_recall,\n",
        "        \"Attack_Recall\": attack_recall,\n",
        "        \"FPR\": fpr,\n",
        "        \"Balanced_Accuracy\": (benign_recall + attack_recall) / 2\n",
        "    }\n",
        "\n",
        "final_federated_results = []\n",
        "\n",
        "final_federated_results.append(\n",
        "    federated_detailed_evaluation(\n",
        "        iid_global_model, \"IID\"\n",
        "    )\n",
        ")\n",
        "\n",
        "final_federated_results.append(\n",
        "    federated_detailed_evaluation(\n",
        "        noniid_global_model, \"Non-IID\"\n",
        "    )\n",
        ")\n",
        "\n",
        "federated_comparison_df = pd.DataFrame(\n",
        "    final_federated_results\n",
        ")\n",
        "\n",
        "print(\"FINAL FEDERATED MODEL CLASS-WISE RESULTS\")\n",
        "display(federated_comparison_df)\n",
        "\n",
        "federated_comparison_df.to_csv(\n",
        "    OUTPUT_DIR / \"Federated_Final_Confusion_Analysis.csv\",\n",
        "    index=False\n",
        ")\n",
        "\n",
        "# Compare all rounds without selecting a test-set best checkpoint\n",
        "round_comparison = pd.DataFrame({\n",
        "    \"Round\": iid_fed_df[\"Round\"],\n",
        "    \"IID_F1\": iid_fed_df[\"F1\"],\n",
        "    \"NonIID_F1\": noniid_fed_df[\"F1\"],\n",
        "    \"IID_Balanced_Accuracy\": iid_fed_df[\"Balanced_Accuracy\"],\n",
        "    \"NonIID_Balanced_Accuracy\": noniid_fed_df[\"Balanced_Accuracy\"]\n",
        "})\n",
        "\n",
        "round_comparison.to_csv(\n",
        "    OUTPUT_DIR / \"IID_NonIID_Round_Comparison.csv\",\n",
        "    index=False\n",
        ")\n",
        "\n",
        "print(\"\\nFinal confusion analysis and round comparison saved.\")"
