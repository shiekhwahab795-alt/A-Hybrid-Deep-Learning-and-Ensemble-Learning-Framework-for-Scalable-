        "# CELL 10: Repeated Runs for Statistical Evaluation\n",
        "\n",
        "import random\n",
        "import numpy as np\n",
        "import pandas as pd\n",
        "import torch\n",
        "import time\n",
        "\n",
        "seeds = [42, 123, 2024, 7, 99]\n",
        "\n",
        "model_classes = {\n",
        "    \"CNN\": CNNClassifier,\n",
        "    \"Transformer\": TransformerClassifier,\n",
        "    \"Hybrid_CNN_Transformer\": HybridNet\n",
        "}\n",
        "\n",
        "repeated_results = []\n",
        "\n",
        "for seed in seeds:\n",
        "\n",
        "    print(f\"\\n{'='*50}\")\n",
        "    print(f\"RUNNING SEED: {seed}\")\n",
        "    print(f\"{'='*50}\")\n",
        "\n",
        "    random.seed(seed)\n",
        "    np.random.seed(seed)\n",
        "    torch.manual_seed(seed)\n",
        "\n",
        "    if torch.cuda.is_available():\n",
        "        torch.cuda.manual_seed_all(seed)\n",
        "\n",
        "    for model_name, model_class in model_classes.items():\n",
        "\n",
        "        print(f\"\\nTraining {model_name} | Seed {seed}\")\n",
        "\n",
        "        model = model_class()\n",
        "\n",
        "        trained_model, training_time = train_model(\n",
        "            model,\n",
        "            epochs=8,\n",
        "            batch_size=1024,\n",
        "            learning_rate=1e-3\n",
        "        )\n",
        "\n",
        "        metrics = evaluate_model(trained_model)\n",
        "\n",
        "        result = {\n",
        "            \"Seed\": seed,\n",
        "            \"Model\": model_name,\n",
        "            \"Training_Time_Seconds\": training_time,\n",
        "            \"Accuracy\": metrics[\"Accuracy\"],\n",
        "            \"Precision\": metrics[\"Precision\"],\n",
        "            \"Recall\": metrics[\"Recall\"],\n",
        "            \"F1\": metrics[\"F1\"],\n",
        "            \"Balanced_Accuracy\": metrics[\"Balanced_Accuracy\"],\n",
        "            \"FPR\": metrics[\"FPR\"]\n",
        "        }\n",
        "\n",
        "        repeated_results.append(result)\n",
        "\n",
        "        print(\n",
        "            f\"Accuracy: {metrics['Accuracy']:.5f} | \"\n",
        "            f\"F1: {metrics['F1']:.5f} | \"\n",
        "            f\"Balanced Accuracy: {metrics['Balanced_Accuracy']:.5f}\"\n",
        "        )\n",
        "\n",
        "        del trained_model, model\n",
        "\n",
        "        if torch.cuda.is_available():\n",
        "            torch.cuda.empty_cache()\n",
        "\n",
        "# Detailed results\n",
        "repeated_df = pd.DataFrame(repeated_results)\n",
        "\n",
        "print(\"\\nALL REPEATED RUN RESULTS\")\n",
        "display(repeated_df)\n",
        "\n",
        "# Mean and standard deviation\n",
        "summary_df = repeated_df.groupby(\"Model\").agg(\n",
        "    Accuracy_Mean=(\"Accuracy\", \"mean\"),\n",
        "    Accuracy_SD=(\"Accuracy\", \"std\"),\n",
        "    F1_Mean=(\"F1\", \"mean\"),\n",
