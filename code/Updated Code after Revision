        "# CELL REVIEW-16: CNN + Transformer + RF soft-voting benchmark\n",
        "\n",
        "import time\n",
        "import numpy as np\n",
        "import pandas as pd\n",
        "import torch\n",
        "from pathlib import Path\n",
        "\n",
        "E = Path(OUTPUT_DIR)\n",
        "\n",
        "cnn = loaded_models[\"CNN\"].to(DEVICE).eval()\n",
        "transformer = loaded_models[\"Transformer\"].to(DEVICE).eval()\n",
        "X_gpu = torch.tensor(X_test_scaled, dtype=torch.float32, device=DEVICE)\n",
        "\n",
        "# Warm-up\n",
        "with torch.no_grad():\n",
        "    cnn(X_gpu[:1024])\n",
        "    transformer(X_gpu[:1024])\n",
        "\n",
        "# Measure complete soft-voting pipeline\n",
        "times = []\n",
        "\n",
        "if torch.cuda.is_available():\n",
        "    torch.cuda.reset_peak_memory_stats()\n",
        "\n",
        "for _ in range(5):\n",
        "    if torch.cuda.is_available():\n",
        "        torch.cuda.synchronize()\n",
        "\n",
        "    start = time.perf_counter()\n",
        "\n",
        "    with torch.no_grad():\n",
        "        cnn_probs = torch.softmax(cnn(X_gpu), dim=1)[:, 1].cpu().numpy()\n",
        "        transformer_probs = torch.softmax(\n",
        "            transformer(X_gpu), dim=1\n",
        "        )[:, 1].cpu().numpy()\n",
        "\n",
        "    rf_probs = rf_model.predict_proba(X_test_scaled)[:, 1]\n",
        "\n",
        "    # Equal-weight soft voting\n",
        "    ensemble_probs = (\n",
        "        cnn_probs + transformer_probs + rf_probs\n",
        "    ) / 3.0\n",
        "\n",
        "    ensemble_predictions = (ensemble_probs >= 0.5).astype(int)\n",
        "\n",
        "    if torch.cuda.is_available():\n",
        "        torch.cuda.synchronize()\n",
        "\n",
        "    times.append(time.perf_counter() - start)\n",
        "\n",
        "ensemble_seconds = float(np.mean(times))\n",
        "n = len(X_test_scaled)\n",
        "\n",
        "ensemble_benchmark = pd.DataFrame([{\n",
        "    \"Model\": \"CNN_Transformer_RF_SoftVote\",\n",
        "    \"Samples\": n,\n",
        "    \"Total_Inference_Seconds\": ensemble_seconds,\n",
        "    \"Latency_ms_per_sample\": ensemble_seconds * 1000 / n,\n",
        "    \"Throughput_samples_per_second\": n / ensemble_seconds,\n",
        "    \"Peak_GPU_Memory_MB\": (\n",
        "        torch.cuda.max_memory_allocated() / (1024 ** 2)\n",
        "        if torch.cuda.is_available() else np.nan\n",
        "    )\n",
        "}])\n",
        "\n",
        "display(ensemble_benchmark.round(6))\n",
        "\n",
        "ensemble_benchmark.to_csv(\n",
        "    E / \"Full_Ensemble_Inference_Benchmark.csv\",\n",
        "    index=False\n",
        ")\n",
        "\n",
        "print(\"Saved: Full_Ensemble_Inference_Benchmark.csv\")"
