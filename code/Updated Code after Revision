        "# CELL 8: Inference Latency and Memory Overhead\n",
        "\n",
        "import time\n",
        "import numpy as np\n",
        "import pandas as pd\n",
        "import torch\n",
        "import psutil\n",
        "import os\n",
        "\n",
        "print(\"Measuring inference latency and memory overhead...\")\n",
        "\n",
        "N = len(X_test_scaled)\n",
        "REPEATS = 20\n",
        "WARMUP = 5\n",
        "\n",
        "# GPU memory baseline\n",
        "if DEVICE.type == \"cuda\":\n",
        "    torch.cuda.empty_cache()\n",
        "    torch.cuda.reset_peak_memory_stats()\n",
        "\n",
        "def sync_device():\n",
        "    if DEVICE.type == \"cuda\":\n",
        "        torch.cuda.synchronize()\n",
        "\n",
        "def measure_neural_model(model, model_name):\n",
        "    model.eval()\n",
        "\n",
        "    # Warm-up\n",
        "    with torch.no_grad():\n",
        "        for _ in range(WARMUP):\n",
        "            _ = model(X_test_tensor[:1024])\n",
        "    sync_device()\n",
        "\n",
        "    # Full test-set inference\n",
        "    full_times = []\n",
        "\n",
        "    with torch.no_grad():\n",
        "        for _ in range(REPEATS):\n",
        "            sync_device()\n",
        "            start = time.perf_counter()\n",
        "            _ = model(X_test_tensor)\n",
        "            sync_device()\n",
        "            full_times.append(time.perf_counter() - start)\n",
        "\n",
        "    # Single-sample inference\n",
        "    single_times = []\n",
        "\n",
        "    with torch.no_grad():\n",
        "        for _ in range(WARMUP):\n",
        "            _ = model(X_test_tensor[:1])\n",
        "    sync_device()\n",
        "\n",
        "    with torch.no_grad():\n",
        "        for _ in range(REPEATS):\n",
        "            sync_device()\n",
        "            start = time.perf_counter()\n",
        "            _ = model(X_test_tensor[:1])\n",
        "            sync_device()\n",
        "            single_times.append(time.perf_counter() - start)\n",
        "\n",
        "    return {\n",
        "        \"Model\": model_name,\n",
        "        \"Full_Test_Time_ms\": np.median(full_times) * 1000,\n",
        "        \"Per_Sample_Batch_Average_ms\": (\n",
        "            np.median(full_times) * 1000 / N\n",
        "        ),\n",
        "        \"Single_Sample_Latency_ms\": np.median(single_times) * 1000\n",
        "    }\n",
        "\n",
        "latency_results = []\n",
        "\n",
        "for name in [\"CNN\", \"Transformer\", \"Hybrid_CNN_Transformer\"]:\n",
        "    latency_results.append(\n",
        "        measure_neural_model(trained_models[name], name)\n",
        "    )\n",
        "\n",
        "# Random Forest CPU inference\n",
        "for _ in range(WARMUP):\n",
        "    _ = rf_model.predict_proba(X_test_scaled[:1024])\n",
        "\n",
        "rf_full_times = []\n",
        "rf_single_times = []\n",
        "\n",
        "for _ in range(REPEATS):\n",
        "    start = time.perf_counter()\n",
        "    _ = rf_model.predict_proba(X_test_scaled)\n",
        "    rf_full_times.append(time.perf_counter() - start)\n",
        "\n",
        "    start = time.perf_counter()\n",
        "    _ = rf_model.predict_proba(X_test_scaled[:1])\n",
        "    rf_single_times.append(time.perf_counter() - start)\n",
        "\n",
        "latency_results.append({\n",
        "    \"Model\": \"Random_Forest\",\n",
        "    \"Full_Test_Time_ms\": np.median(rf_full_times) * 1000,\n",
        "    \"Per_Sample_Batch_Average_ms\": (\n",
        "        np.median(rf_full_times) * 1000 / N\n",
        "    ),\n",
        "    \"Single_Sample_Latency_ms\": np.median(rf_single_times) * 1000\n",
        "})\n",
        "\n",
        "latency_df = pd.DataFrame(latency_results)\n",
        "\n",
        "print(\"\\nINFERENCE LATENCY RESULTS\")\n",
        "display(latency_df)\n",
        "\n",
