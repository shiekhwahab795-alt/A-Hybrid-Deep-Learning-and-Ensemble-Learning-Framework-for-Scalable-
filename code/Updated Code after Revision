      "source": [
        "# CELL 14: Federated Averaging (IID)\n",
        "\n",
        "import copy\n",
        "import random\n",
        "import time\n",
        "import numpy as np\n",
        "import pandas as pd\n",
        "import torch\n",
        "import torch.nn as nn\n",
        "\n",
        "from torch.utils.data import TensorDataset, DataLoader\n",
        "\n",
        "NUM_ROUNDS = 32\n",
        "CLIENTS_PER_ROUND = 5\n",
        "LOCAL_EPOCHS = 1\n",
        "BATCH_SIZE = 1024\n",
        "FED_SEED = 42\n",
        "\n",
        "random.seed(FED_SEED)\n",
        "np.random.seed(FED_SEED)\n",
        "torch.manual_seed(FED_SEED)\n",
        "\n",
        "if torch.cuda.is_available():\n",
        "    torch.cuda.manual_seed_all(FED_SEED)\n",
        "\n",
        "def local_client_training(global_model, client_indices):\n",
        "    local_model = copy.deepcopy(global_model).to(DEVICE)\n",
        "    local_model.train()\n",
        "\n",
        "    client_x = X_train_tensor[client_indices]\n",
        "    client_y = y_train_tensor[client_indices]\n",
        "\n",
        "    loader = DataLoader(\n",
        "        TensorDataset(client_x, client_y),\n",
        "        batch_size=BATCH_SIZE,\n",
        "        shuffle=True\n",
        "    )\n",
        "\n",
        "    weights = torch.tensor(\n",
        "        [class_weights[0], class_weights[1]],\n",
        "        dtype=torch.float32,\n",
        "        device=DEVICE\n",
        "    )\n",
        "\n",
        "    criterion = nn.CrossEntropyLoss(weight=weights)\n",
        "\n",
        "    optimizer = torch.optim.AdamW(\n",
        "        local_model.parameters(),\n",
        "        lr=1e-3\n",
        "    )\n",
        "\n",
        "    for epoch in range(LOCAL_EPOCHS):\n",
        "        for batch_x, batch_y in loader:\n",
        "            optimizer.zero_grad(set_to_none=True)\n",
        "            outputs = local_model(batch_x)\n",
        "            loss = criterion(outputs, batch_y)\n",
        "            loss.backward()\n",
        "            optimizer.step()\n",
        "\n",
        "    updated_state = {\n",
        "        key: value.detach().cpu().clone()\n",
        "        for key, value in local_model.state_dict().items()\n",
        "    }\n",
        "\n",
        "    del local_model\n",
        "    if torch.cuda.is_available():\n",
        "        torch.cuda.empty_cache()\n",
        "\n",
        "    return updated_state\n",
        "\n",
        "\n",
        "def fedavg_aggregate(client_states, client_sizes):\n",
        "    total_samples = sum(client_sizes)\n",
        "\n",
        "    aggregated_state = {}\n",
        "\n",
        "    for key in client_states[0].keys():\n",
        "        aggregated_state[key] = sum(\n",
        "            client_states[i][key] *\n",
        "            (client_sizes[i] / total_samples)\n",
        "            for i in range(len(client_states))\n",
        "        )\n",
        "\n",
        "    return aggregated_state\n",
        "\n",
        "\n",
        "def evaluate_federated_model(model):\n",
        "    model.eval()\n",
        "\n",
        "    with torch.no_grad():\n",
        "        outputs = model(X_test_tensor)\n",
        "        predictions = outputs.argmax(dim=1).cpu().numpy()\n",
        "\n",
        "    actual = y_test_tensor.cpu().numpy()\n",
        "\n",
        "    from sklearn.metrics import (\n",
        "        accuracy_score, precision_score, recall_score,\n",
        "        f1_score, balanced_accuracy_score, confusion_matrix\n",
        "    )\n",
        "\n",
        "    cm = confusion_matrix(actual, predictions, labels=[0, 1])\n",
        "    tn, fp, fn, tp = cm.ravel()\n",
        "\n",
        "    return {\n",
        "        \"Accuracy\": accuracy_score(actual, predictions),\n",
        "        \"Precision\": precision_score(actual, predictions, zero_division=0),\n",
        "        \"Recall\": recall_score(actual, predictions, zero_division=0),\n",
        "        \"F1\": f1_score(actual, predictions, zero_division=0),\n",
        "        \"Balanced_Accuracy\": balanced_accuracy_score(actual, predictions),\n",
        "        \"FPR\": fp / (fp + tn) if (fp + tn) else 0\n",
        "    }\n",
        "\n",
        "\n",
        "print(\"Starting IID Federated Training...\")\n",
        "\n",
        "iid_global_model = HybridNet().to(DEVICE)\n",
        "\n",
        "iid_round_results = []\n",
        "iid_start_time = time.time()\n",
        "\n",
        "for round_number in range(NUM_ROUNDS):\n",
        "\n",
        "    selected_clients = np.random.choice(\n",
        "        NUM_CLIENTS,\n",
        "        size=CLIENTS_PER_ROUND,\n",
        "        replace=False\n",
        "    )\n",
        "\n",
        "    client_states = []\n",
        "    client_sizes = []\n",
        "\n",
        "    print(\n",
        "        f\"\\nRound {round_number + 1}/{NUM_ROUNDS} | \"\n",
        "        f\"Selected clients: {selected_clients + 1}\"\n",
        "    )\n",
        "\n",
        "    for client_id in selected_clients:\n",
        "\n",
        "        state = local_client_training(\n",
        "            iid_global_model,\n",
        "            iid_clients[client_id]\n",
        "        )\n",
        "\n",
        "        client_states.append(state)\n",
        "        client_sizes.append(len(iid_clients[client_id]))\n",
        "\n",
        "    new_global_state = fedavg_aggregate(\n",
        "        client_states,\n",
        "        client_sizes\n",
        "    )\n",
        "\n",
        "    iid_global_model.load_state_dict(new_global_state)\n",
        "\n",
        "    metrics = evaluate_federated_model(iid_global_model)\n",
        "\n",
        "    iid_round_results.append({\n",
        "        \"Round\": round_number + 1,\n",
        "        **metrics\n",
        "    })\n",
        "\n",
        "    print(\n",
        "        f\"Accuracy: {metrics['Accuracy']:.5f} | \"\n",
        "        f\"F1: {metrics['F1']:.5f} | \"\n",
        "        f\"Balanced Accuracy: {metrics['Balanced_Accuracy']:.5f}\"\n",
        "    )\n",
        "\n",
        "iid_training_time = time.time() - iid_start_time\n",
        "\n",
        "iid_fed_df = pd.DataFrame(iid_round_results)\n",
        "\n",
        "iid_fed_df.to_csv(\n",
        "    OUTPUT_DIR / \"FedAvg_IID_Round_Results.csv\",\n",
        "    index=False\n",
        ")\n",
        "\n",
        "torch.save(\n",
        "    iid_global_model.state_dict(),\n",
        "    OUTPUT_DIR / \"FedAvg_IID_Hybrid_Model.pth\"\n",
        ")\n",
        "\n",
        "print(\"\\nIID FEDERATED TRAINING COMPLETED\")\n",
        "print(\"Total training time:\", round(iid_training_time, 2), \"seconds\")\n",
        "\n",
        "display(iid_fed_df.tail())"
      ],
