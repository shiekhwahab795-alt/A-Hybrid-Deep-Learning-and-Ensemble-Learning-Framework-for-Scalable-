        "# CELL 12: CNN, Transformer and Hybrid Model Definitions\n",
        "\n",
        "import torch\n",
        "import torch.nn as nn\n",
        "import torch.nn.functional as F\n",
        "\n",
        "# Device configuration\n",
        "DEVICE = torch.device(\n",
        "    \"cuda\" if torch.cuda.is_available() else \"cpu\"\n",
        ")\n",
        "\n",
        "print(\"Available device:\", DEVICE)\n",
        "\n",
        "if torch.cuda.is_available():\n",
        "    print(\"GPU:\", torch.cuda.get_device_name(0))\n",
        "\n",
        "\n",
        "# CNN Encoder\n",
        "class CNNEncoder(nn.Module):\n",
        "\n",
        "    def __init__(self):\n",
        "        super().__init__()\n",
        "\n",
        "        self.conv1 = nn.Conv1d(1, 32, kernel_size=3, padding=1)\n",
        "        self.conv2 = nn.Conv1d(32, 64, kernel_size=3, padding=1)\n",
        "        self.pool = nn.AdaptiveAvgPool1d(1)\n",
        "\n",
        "    def forward(self, x):\n",
        "\n",
        "        x = x.unsqueeze(1)\n",
        "\n",
        "        x = F.relu(self.conv1(x))\n",
        "        x = F.relu(self.conv2(x))\n",
        "\n",
        "        x = self.pool(x).squeeze(-1)\n",
        "\n",
        "        return x\n",
        "\n",
        "\n",
        "# Transformer Encoder\n",
        "class TransformerEncoderModel(nn.Module):\n",
        "\n",
        "    def __init__(self, feature_dim=64):\n",
        "        super().__init__()\n",
        "\n",
        "        self.embedding = nn.Linear(1, feature_dim)\n",
        "\n",
        "        encoder_layer = nn.TransformerEncoderLayer(\n",
        "            d_model=feature_dim,\n",
        "            nhead=4,\n",
        "            dim_feedforward=128,\n",
        "            dropout=0.1,\n",
        "            batch_first=True\n",
        "        )\n",
        "\n",
        "        self.transformer = nn.TransformerEncoder(\n",
        "            encoder_layer,\n",
        "            num_layers=2\n",
        "        )\n",
        "\n",
        "    def forward(self, x):\n",
        "\n",
        "        x = x.unsqueeze(-1)\n",
        "\n",
        "        x = self.embedding(x)\n",
        "\n",
        "        x = self.transformer(x)\n",
        "\n",
        "        x = x.mean(dim=1)\n",
        "\n",
        "        return x\n",
        "\n",
        "\n",
        "# CNN-only classifier\n",
        "class CNNClassifier(nn.Module):\n",
        "\n",
        "    def __init__(self, num_classes=2):\n",
        "        super().__init__()\n",
        "\n",
        "        self.encoder = CNNEncoder()\n",
        "        self.classifier = nn.Linear(64, num_classes)\n",
        "\n",
        "    def forward(self, x):\n",
        "\n",
        "        features = self.encoder(x)\n",
        "\n",
        "        return self.classifier(features)\n",
        "\n",
        "\n",
        "# Transformer-only classifier\n",
        "class TransformerClassifier(nn.Module):\n",
        "\n",
        "    def __init__(self, num_classes=2):\n",
        "        super().__init__()\n",
        "\n",
        "        self.encoder = TransformerEncoderModel()\n",
        "        self.classifier = nn.Linear(64, num_classes)\n",
        "\n",
        "    def forward(self, x):\n",
        "\n",
        "        features = self.encoder(x)\n",
        "\n",
        "        return self.classifier(features)\n",
        "\n",
        "\n",
        "# Hybrid CNN + Transformer classifier\n",
        "class HybridNet(nn.Module):\n",
        "\n",
        "    def __init__(self, num_classes=2):\n",
        "        super().__init__()\n",
        "\n",
        "        self.cnn = CNNEncoder()\n",
        "        self.transformer = TransformerEncoderModel()\n",
        "\n",
        "        self.classifier = nn.Sequential(\n",
        "            nn.Linear(128, 64),\n",
        "            nn.ReLU(),\n",
        "            nn.Dropout(0.1),\n",
        "            nn.Linear(64, num_classes)\n",
        "        )\n",
        "\n",
        "    def forward(self, x):\n",
        "\n",
        "        cnn_features = self.cnn(x)\n",
        "        transformer_features = self.transformer(x)\n",
        "\n",
        "        combined = torch.cat(\n",
        "            [cnn_features, transformer_features],\n",
        "            dim=1\n",
        "        )\n",
        "\n",
        "        return self.classifier(combined)\n",
        "\n",
        "\n",
        "# Architecture verification\n",
        "sample_input = torch.randn(4, X_train_scaled.shape[1]).to(DEVICE)\n",
