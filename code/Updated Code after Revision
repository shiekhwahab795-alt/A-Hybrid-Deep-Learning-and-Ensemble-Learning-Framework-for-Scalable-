        "# CELL REVIEW-4: Independently recalculate all model metrics\n",
        "\n",
        "import pandas as pd\n",
        "import numpy as np\n",
        "from pathlib import Path\n",
        "from sklearn.metrics import (\n",
        "    accuracy_score, precision_score, recall_score,\n",
        "    f1_score, balanced_accuracy_score, confusion_matrix\n",
        ")\n",
        "\n",
        "E = Path(OUTPUT_DIR)\n",
        "\n",
        "prediction_map = {\n",
        "    \"CNN\": \"CNN_predictions.csv\",\n",
        "    \"Transformer\": \"Transformer_predictions.csv\",\n",
        "    \"Hybrid_CNN_Transformer\": \"Hybrid_CNN_Transformer_predictions.csv\",\n",
        "    \"Random_Forest\": \"RandomForest_predictions.csv\"\n",
        "}\n",
        "\n",
        "verified_results = []\n",
        "\n",
        "reference_actual = None\n",
        "\n",
        "for model_name, filename in prediction_map.items():\n",
        "\n",
        "    df = pd.read_csv(E / filename)\n",
        "\n",
        "    y_true = df[\"Actual\"].astype(int).to_numpy()\n",
        "    y_pred = df[\"Predicted\"].astype(int).to_numpy()\n",
        "\n",
        "    if reference_actual is None:\n",
        "        reference_actual = y_true.copy()\n",
        "    else:\n",
        "        assert np.array_equal(reference_actual, y_true), (\n",
        "            f\"Actual labels mismatch in {model_name}\"\n",
        "        )\n",
        "\n",
        "    tn, fp, fn, tp = confusion_matrix(\n",
        "        y_true, y_pred, labels=[0, 1]\n",
        "    ).ravel()\n",
        "\n",
        "    specificity = tn / (tn + fp) if (tn + fp) else 0\n",
        "    fpr = fp / (fp + tn) if (fp + tn) else 0\n",
        "\n",
        "    verified_results.append({\n",
        "        \"Model\": model_name,\n",
        "        \"Accuracy\": accuracy_score(y_true, y_pred),\n",
        "        \"Precision\": precision_score(y_true, y_pred, zero_division=0),\n",
        "        \"Attack_Recall\": recall_score(y_true, y_pred, zero_division=0),\n",
        "        \"F1\": f1_score(y_true, y_pred, zero_division=0),\n",
        "        \"Specificity\": specificity,\n",
        "        \"FPR\": fpr,\n",
        "        \"Balanced_Accuracy\": balanced_accuracy_score(y_true, y_pred),\n",
        "        \"TN\": tn,\n",
        "        \"FP\": fp,\n",
        "        \"FN\": fn,\n",
        "        \"TP\": tp\n",
        "    })\n",
        "\n",
        "verified_df = pd.DataFrame(verified_results)\n",
        "\n",
        "print(\"ACTUAL LABEL DISTRIBUTION\")\n",
        "print(pd.Series(reference_actual).value_counts().sort_index())\n",
        "\n",
        "print(\"\\nINDEPENDENTLY VERIFIED RESULTS\")\n",
