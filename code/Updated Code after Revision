        "# CELL 15: Federated Averaging (Non-IID)\n",
        "\n",
        "import copy\n",
        "import random\n",
        "import time\n",
        "import numpy as np\n",
        "import pandas as pd\n",
        "import torch\n",
        "\n",
        "FED_SEED = 42\n",
        "\n",
        "random.seed(FED_SEED)\n",
        "np.random.seed(FED_SEED)\n",
        "torch.manual_seed(FED_SEED)\n",
        "\n",
        "if torch.cuda.is_available():\n",
        "    torch.cuda.manual_seed_all(FED_SEED)\n",
        "\n",
        "print(\"Starting Non-IID Federated Training...\")\n",
        "\n",
        "noniid_global_model = HybridNet().to(DEVICE)\n",
        "\n",
        "noniid_round_results = []\n",
        "noniid_start_time = time.time()\n",
        "\n",
        "for round_number in range(NUM_ROUNDS):\n",
        "\n",
        "    selected_clients = np.random.choice(\n",
        "        NUM_CLIENTS,\n",
        "        size=CLIENTS_PER_ROUND,\n",
        "        replace=False\n",
        "    )\n",
        "\n",
        "    client_states = []\n",
        "    client_sizes = []\n",
        "\n",
        "    print(\n",
        "        f\"\\nRound {round_number + 1}/{NUM_ROUNDS} | \"\n",
        "        f\"Selected clients: {selected_clients + 1}\"\n",
        "    )\n",
        "\n",
        "    for client_id in selected_clients:\n",
        "\n",
        "        state = local_client_training(\n",
        "            noniid_global_model,\n",
        "            noniid_clients[client_id]\n",
        "        )\n",
        "\n",
        "        client_states.append(state)\n",
        "        client_sizes.append(len(noniid_clients[client_id]))\n",
        "\n",
        "    new_global_state = fedavg_aggregate(\n",
        "        client_states,\n",
        "        client_sizes\n",
        "    )\n",
        "\n",
        "    noniid_global_model.load_state_dict(new_global_state)\n",
        "\n",
        "    metrics = evaluate_federated_model(noniid_global_model)\n",
        "\n",
        "    noniid_round_results.append({\n",
        "        \"Round\": round_number + 1,\n",
        "        **metrics\n",
        "    })\n",
        "\n",
        "    print(\n",
        "        f\"Accuracy: {metrics['Accuracy']:.5f} | \"\n",
        "        f\"F1: {metrics['F1']:.5f} | \"\n",
        "        f\"Balanced Accuracy: {metrics['Balanced_Accuracy']:.5f}\"\n",
        "    )\n",
        "\n",
        "noniid_training_time = time.time() - noniid_start_time\n",
        "\n",
        "noniid_fed_df = pd.DataFrame(noniid_round_results)\n",
        "\n",
        "# Save all round results\n",
        "noniid_fed_df.to_csv(\n",
        "    OUTPUT_DIR / \"FedAvg_NonIID_Round_Results.csv\",\n",
        "    index=False\n",
        ")\n",
        "\n",
        "# Save final global model\n",
        "torch.save(\n",
        "    noniid_global_model.state_dict(),\n",
        "    OUTPUT_DIR / \"FedAvg_NonIID_Hybrid_Model.pth\"\n",
        ")\n",
        "\n",
        "# Best and final round comparison\n",
        "best_idx = noniid_fed_df[\"F1\"].idxmax()\n",
        "\n",
        "print(\"\\nNON-IID FEDERATED TRAINING COMPLETED\")\n",
        "print(\"Total training time:\", round(noniid_training_time, 2), \"seconds\")\n",
        "\n",
        "print(\"\\nBEST ROUND:\")\n",
        "display(noniid_fed_df.loc[[best_idx]])\n",
        "\n",
        "print(\"\\nFINAL ROUND:\")\n",
        "display(noniid_fed_df.tail(1))\n",
        "\n",
        "print(\"\\nAll Non-IID results saved successfully.\")"
