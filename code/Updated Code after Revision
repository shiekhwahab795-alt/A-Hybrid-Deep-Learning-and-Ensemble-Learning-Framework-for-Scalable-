        "# CELL 13: Create IID and Non-IID Federated Clients\n",
        "\n",
        "import numpy as np\n",
        "import torch\n",
        "\n",
        "NUM_CLIENTS = 20\n",
        "CLIENT_SEED = 42\n",
        "\n",
        "y_np = y_train_tensor.cpu().numpy()\n",
        "rng = np.random.default_rng(CLIENT_SEED)\n",
        "\n",
        "class_0_indices = np.where(y_np == 0)[0]\n",
        "class_1_indices = np.where(y_np == 1)[0]\n",
        "\n",
        "# IID: shuffle all training samples and divide equally\n",
        "all_indices = rng.permutation(len(y_np))\n",
        "iid_clients = np.array_split(all_indices, NUM_CLIENTS)\n",
        "\n",
        "# Non-IID: distribute each class using Dirichlet allocation\n",
        "def create_dirichlet_clients(labels, num_clients, alpha, seed=42):\n",
        "    rng_local = np.random.default_rng(seed)\n",
        "    clients = [[] for _ in range(num_clients)]\n",
        "\n",
        "    for class_label in np.unique(labels):\n",
        "        indices = np.where(labels == class_label)[0]\n",
        "        rng_local.shuffle(indices)\n",
        "\n",
        "        proportions = rng_local.dirichlet(\n",
        "            np.repeat(alpha, num_clients)\n",
        "        )\n",
        "\n",
        "        split_points = (\n",
        "            np.cumsum(proportions)[:-1] * len(indices)\n",
        "        ).astype(int)\n",
        "\n",
        "        class_splits = np.split(indices, split_points)\n",
        "\n",
        "        for client_id, split in enumerate(class_splits):\n",
        "            clients[client_id].extend(split.tolist())\n",
        "\n",
        "    return [\n",
        "        np.array(rng_local.permutation(client_indices))\n",
        "        for client_indices in clients\n",
        "    ]\n",
        "\n",
        "noniid_clients = create_dirichlet_clients(\n",
        "    y_np,\n",
        "    num_clients=NUM_CLIENTS,\n",
        "    alpha=0.3,\n",
        "    seed=CLIENT_SEED\n",
        ")\n",
        "\n",
        "# Validate client partitions\n",
        "assert sum(map(len, iid_clients)) == len(y_np)\n",
        "assert sum(map(len, noniid_clients)) == len(y_np)\n",
        "\n",
        "assert len(np.unique(np.concatenate(iid_clients))) == len(y_np)\n",
        "assert len(np.unique(np.concatenate(noniid_clients))) == len(y_np)\n",
        "\n",
        "# Client distribution report\n",
        "def client_distribution(clients, labels, setting):\n",
        "    rows = []\n",
        "\n",
        "    for client_id, indices in enumerate(clients):\n",
        "        client_labels = labels[indices]\n",
        "\n",
        "        rows.append({\n",
        "            \"Setting\": setting,\n",
        "            \"Client\": client_id + 1,\n",
        "            \"Samples\": len(indices),\n",
        "            \"Benign\": int(np.sum(client_labels == 0)),\n",
        "            \"Attack\": int(np.sum(client_labels == 1)),\n",
        "            \"Benign_Percent\": float(\n",
        "                np.mean(client_labels == 0) * 100\n",
        "            )\n",
        "        })\n",
        "\n",
        "    return rows\n",
