        "# CELL 10: Leakage-Aware Group Train/Test Split\n",
        "\n",
        "import numpy as np\n",
        "import pandas as pd\n",
        "from sklearn.model_selection import StratifiedGroupKFold\n",
        "\n",
        "X = train_raw.drop(\n",
        "    columns=[\"label\", \"binary_label\", \"_source_file\"]\n",
        ").copy()\n",
        "\n",
        "y = train_raw[\"binary_label\"].astype(int)\n",
        "groups = train_raw[\"_source_file\"]\n",
        "\n",
        "# Numeric conversion\n",
        "X = X.apply(pd.to_numeric, errors=\"coerce\")\n",
        "\n",
        "# Replace invalid values\n",
        "X = X.replace([np.inf, -np.inf], np.nan)\n",
        "\n",
        "# Stratified group split\n",
        "sgkf = StratifiedGroupKFold(\n",
        "    n_splits=5,\n",
        "    shuffle=True,\n",
        "    random_state=42\n",
        ")\n",
        "\n",
        "splits = list(sgkf.split(X, y, groups))\n",
        "\n",
        "# Select fold with closest test class ratio to overall ratio\n",
        "overall_ratio = y.mean()\n",
        "\n",
        "best_fold = None\n",
        "best_difference = float(\"inf\")\n",
        "\n",
        "for fold_number, (train_idx, test_idx) in enumerate(splits):\n",
        "\n",
        "    test_ratio = y.iloc[test_idx].mean()\n",
        "    difference = abs(test_ratio - overall_ratio)\n",
        "\n",
        "    if difference < best_difference:\n",
        "        best_difference = difference\n",
        "        best_fold = (train_idx, test_idx)\n",
        "\n",
        "train_idx, test_idx = best_fold\n",
        "\n",
        "X_train = X.iloc[train_idx].copy()\n",
        "X_test = X.iloc[test_idx].copy()\n",
        "\n",
        "y_train = y.iloc[train_idx].copy()\n",
