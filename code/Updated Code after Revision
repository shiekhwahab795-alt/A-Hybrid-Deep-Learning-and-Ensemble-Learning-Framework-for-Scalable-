        "\n",
        "import time\n",
        "import joblib\n",
        "import numpy as np\n",
        "import pandas as pd\n",
        "\n",
        "from sklearn.compose import ColumnTransformer\n",
        "from sklearn.pipeline import Pipeline\n",
        "from sklearn.impute import SimpleImputer\n",
        "from sklearn.preprocessing import OneHotEncoder\n",
        "from sklearn.ensemble import RandomForestClassifier\n",
        "from sklearn.metrics import (\n",
        "    accuracy_score, precision_score, recall_score,\n",
        "    f1_score, classification_report, confusion_matrix\n",
        ")\n",
        "\n",
        "# Feature definitions from Step 4\n",
        "numeric_features = [\n",
        "    \"message_numeric\", \"array_1\", \"array_2\", \"array_3\"\n",
        "]\n",
        "\n",
        "categorical_features = [\n",
        "    \"value_type\", \"message_type\", \"application\"\n",
        "]\n",
        "\n",
        "# Preprocessing: fit only on training data\n",
        "numeric_pipeline = Pipeline([\n",
        "    (\"imputer\", SimpleImputer(strategy=\"median\"))\n",
        "])\n",
        "\n",
        "categorical_pipeline = Pipeline([\n",
        "    (\"imputer\", SimpleImputer(strategy=\"most_frequent\")),\n",
        "    (\"encoder\", OneHotEncoder(\n",
        "        handle_unknown=\"ignore\",\n",
        "        min_frequency=10\n",
        "    ))\n",
        "])\n",
        "\n",
        "preprocessor = ColumnTransformer([\n",
        "    (\"numeric\", numeric_pipeline, numeric_features),\n",
        "    (\"categorical\", categorical_pipeline, categorical_features)\n",
        "])\n",
        "\n",
        "# Baseline classifier\n",
        "rf = RandomForestClassifier(\n",
        "    n_estimators=100,\n",
        "    max_depth=20,\n",
        "    min_samples_leaf=2,\n",
        "    class_weight=\"balanced_subsample\",\n",
        "    random_state=42,\n",
        "    n_jobs=-1\n",
        ")\n",
        "\n",
        "model = Pipeline([\n",
        "    (\"preprocessing\", preprocessor),\n",
        "    (\"classifier\", rf)\n",
        "])\n",
        "\n",
        "# Training\n",
        "print(\"Random Forest training started...\")\n",
        "start = time.time()\n",
        "\n",
        "model.fit(X_train, y_train)\n",
        "\n",
        "training_time = time.time() - start\n",
        "print(\"Training time:\", round(training_time, 2), \"seconds\")\n",
        "\n",
        "# Evaluation function\n",
        "def evaluate_model(X, y, name):\n",
        "    start = time.time()\n",
        "    pred = model.predict(X)\n",
        "    elapsed = time.time() - start\n",
        "\n",
        "    print(f\"\\n========== {name} RESULTS ==========\")\n",
        "    print(\"Accuracy:\", round(accuracy_score(y, pred), 6))\n",
        "    print(\"Macro Precision:\", round(\n",
        "        precision_score(y, pred, average=\"macro\", zero_division=0), 6\n",
        "    ))\n",
        "    print(\"Macro Recall:\", round(\n",
        "        recall_score(y, pred, average=\"macro\", zero_division=0), 6\n",
        "    ))\n",
        "    print(\"Macro F1:\", round(\n",
        "        f1_score(y, pred, average=\"macro\", zero_division=0), 6\n",
        "    ))\n",
        "    print(\"Weighted F1:\", round(\n",
        "        f1_score(y, pred, average=\"weighted\", zero_division=0), 6\n",
        "    ))\n",
        "\n",
        "    print(\"\\nClassification Report:\")\n",
        "    print(classification_report(\n",
        "        y, pred,\n",
        "        labels=np.arange(len(CLASS_NAMES)),\n",
        "        target_names=CLASS_NAMES,\n",
        "        zero_division=0\n",
        "    ))\n",
        "\n",
        "    print(\"Confusion Matrix:\")\n",
        "    print(confusion_matrix(\n",
        "        y, pred,\n",
        "        labels=np.arange(len(CLASS_NAMES))\n",
        "    ))\n",
        "\n",
        "    print(\"Inference time:\", round(elapsed, 3), \"seconds\")\n",
        "    print(\"Average latency:\", round(elapsed / len(X) * 1000, 6), \"ms/sample\")\n",
        "\n",
        "    return pred\n",
        "\n",
        "# Validation and final test\n",
        "val_predictions = evaluate_model(X_val, y_val, \"VALIDATION\")\n",
        "test_predictions = evaluate_model(X_test, y_test, \"TEST\")\n",
        "\n",
        "# Save model\n",
        "MODEL_PATH = \"/content/drive/MyDrive/CIC_IDS_2025_RF_baseline.joblib\"\n",
        "joblib.dump(model, MODEL_PATH)\n",
        "\n",
        "# Save test predictions\n",
        "prediction_output = pd.DataFrame({\n",
        "    \"actual\": LE.inverse_transform(np.asarray(y_test)),\n",
        "    \"predicted\": LE.inverse_transform(test_predictions)\n",
        "})\n",
        "\n",
        "PRED_PATH = \"/content/drive/MyDrive/CIC_IDS_2025_RF_predictions.csv\"\n",
        "prediction_output.to_csv(PRED_PATH, index=False)\n",
