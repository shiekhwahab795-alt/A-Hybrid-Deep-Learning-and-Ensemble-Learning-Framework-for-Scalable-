        ")\n",
        "\n",
        "print(\"\\nCONSTANT FEATURES:\")\n",
        "constant_features = [\n",
        "    c for c in X_audit.columns\n",
        "    if X_audit[c].nunique(dropna=True) <= 1\n",
        "]\n",
        "print(constant_features)\n",
