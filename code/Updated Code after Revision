        "DP_BATCH_SIZE = BATCH_SIZE\n",
        "DP_LR = 1e-3\n",
        "\n",
        "def dp_local_client_training(global_model, client_indices):\n",
        "    \"\"\"Train one client and return its model update (delta).\"\"\"\n",
        "\n",
        "    local_model = copy.deepcopy(global_model).to(DEVICE)\n",
        "    local_model.train()\n",
        "\n",
        "    client_x = X_train_tensor[client_indices]\n",
        "    client_y = y_train_tensor[client_indices]\n",
        "\n",
        "    loader = DataLoader(\n",
        "        TensorDataset(client_x, client_y),\n",
        "        batch_size=DP_BATCH_SIZE,\n",
        "        shuffle=True\n",
        "    )\n",
        "\n",
        "    # No globally calculated class weights in this DP experiment\n",
        "    criterion = nn.CrossEntropyLoss()\n",
        "\n",
        "    optimizer = torch.optim.AdamW(\n",
        "        local_model.parameters(),\n",
        "        lr=DP_LR\n",
        "    )\n",
        "\n",
        "    for epoch in range(DP_LOCAL_EPOCHS):\n",
        "        for batch_x, batch_y in loader:\n",
        "            optimizer.zero_grad(set_to_none=True)\n",
        "            outputs = local_model(batch_x)\n",
        "            loss = criterion(outputs, batch_y)\n",
        "            loss.backward()\n",
        "            optimizer.step()\n",
        "\n",
        "    global_state = global_model.state_dict()\n",
        "    local_state = local_model.state_dict()\n",
        "\n",
        "    # Compute client update\n",
        "    client_delta = {\n",
        "        key: (local_state[key].detach().cpu().float()\n",
        "              - global_state[key].detach().cpu().float())\n",
        "        for key in global_state\n",
        "    }\n",
        "\n",
        "    del local_model\n",
        "    if torch.cuda.is_available():\n",
        "        torch.cuda.empty_cache()\n",
        "\n",
        "    return client_delta\n",
        "\n",
        "\n",
        "def clip_client_update(client_delta, clip_norm):\n",
        "    \"\"\"Clip the complete client update using its L2 norm.\"\"\"\n",
        "\n",
        "    squared_norm = sum(\n",
        "        torch.sum(value ** 2)\n",
        "        for value in client_delta.values()\n",
        "    )\n",
        "\n",
        "    update_norm = torch.sqrt(squared_norm)\n",
        "    clipping_factor = min(\n",
        "        1.0,\n",
        "        clip_norm / (update_norm.item() + 1e-12)\n",
        "    )\n",
        "\n",
        "    clipped_delta = {\n",
        "        key: value * clipping_factor\n",
        "        for key, value in client_delta.items()\n",
        "    }\n",
        "\n",
        "    return clipped_delta, update_norm.item()\n",
        "\n",
        "\n",
        "def dp_aggregate_updates(client_deltas, clip_norm, noise_multiplier):\n",
        "    \"\"\"\n",
        "    Equal-weight aggregation.\n",
        "    Replacement sensitivity is bounded by 2*C/m.\n",
        "    Gaussian noise std = noise_multiplier * 2*C/m.\n",
        "    \"\"\"\n",
        "\n",
        "    number_of_clients = len(client_deltas)\n",
        "    if number_of_clients == 0:\n",
        "        raise ValueError(\"No client updates supplied.\")\n",
        "\n",
        "    aggregated_delta = {}\n",
        "\n",
        "    noise_std = (\n",
        "        noise_multiplier * 2.0 * clip_norm / number_of_clients\n",
        "    )\n",
        "\n",
        "    for key in client_deltas[0]:\n",
        "        mean_delta = torch.stack(\n",
        "            [delta[key] for delta in client_deltas],\n",
        "            dim=0\n",
        "        ).mean(dim=0)\n",
        "\n",
        "        noise = torch.randn_like(mean_delta) * noise_std\n",
        "        aggregated_delta[key] = mean_delta + noise\n",
        "\n",
        "    return aggregated_delta\n",
        "\n",
        "\n",
        "def apply_dp_update(global_model, aggregated_delta):\n",
        "    \"\"\"Apply the noisy aggregate update to the global model.\"\"\"\n",
        "\n",
        "    global_state = global_model.state_dict()\n",
        "    updated_state = {}\n",
        "\n",
        "    for key in global_state:\n",
        "        updated_state[key] = (\n",
        "            global_state[key].detach().cpu().float()\n",
        "            + aggregated_delta[key]\n",
        "        )\n",
        "\n",
        "    global_model.load_state_dict(updated_state)\n",
        "    return global_model\n",
        "\n",
