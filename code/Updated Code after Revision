        "# CELL 6: Random Forest Baseline\n",
        "\n",
        "import time\n",
        "import numpy as np\n",
        "import pandas as pd\n",
        "\n",
        "from sklearn.ensemble import RandomForestClassifier\n",
        "from sklearn.metrics import (\n",
        "    accuracy_score,\n",
        "    precision_score,\n",
        "    recall_score,\n",
        "    f1_score,\n",
        "    balanced_accuracy_score,\n",
        "    confusion_matrix\n",
        ")\n",
        "\n",
        "print(\"Training Random Forest...\")\n",
        "\n",
        "rf_model = RandomForestClassifier(\n",
        "    n_estimators=250,\n",
        "    class_weight=\"balanced_subsample\",\n",
        "    random_state=42,\n",
        "    n_jobs=-1,\n",
        "    max_features=\"sqrt\"\n",
        ")\n",
        "\n",
        "start_time = time.time()\n",
        "\n",
        "rf_model.fit(X_train_scaled, y_train)\n",
        "\n",
        "rf_training_time = time.time() - start_time\n",
        "\n",
        "# Predict probabilities\n",
        "start_time = time.time()\n",
        "\n",
        "rf_probabilities = rf_model.predict_proba(X_test_scaled)\n",
        "rf_predictions = rf_model.classes_[\n",
        "    np.argmax(rf_probabilities, axis=1)\n",
        "]\n",
        "\n",
        "rf_inference_time = time.time() - start_time\n",
        "\n",
        "# Evaluation\n",
        "rf_cm = confusion_matrix(\n",
        "    y_test,\n",
        "    rf_predictions,\n",
        "    labels=[0, 1]\n",
        ")\n",
        "\n",
        "tn, fp, fn, tp = rf_cm.ravel()\n",
        "\n",
        "rf_fpr = fp / (fp + tn) if (fp + tn) else 0\n",
        "\n",
        "rf_results = {\n",
        "    \"Model\": \"Random_Forest\",\n",
        "    \"Accuracy\": accuracy_score(y_test, rf_predictions),\n",
        "    \"Precision\": precision_score(\n",
        "        y_test, rf_predictions, zero_division=0\n",
        "    ),\n",
        "    \"Recall\": recall_score(\n",
        "        y_test, rf_predictions, zero_division=0\n",
        "    ),\n",
        "    \"F1\": f1_score(\n",
        "        y_test, rf_predictions, zero_division=0\n",
        "    ),\n",
        "    \"Balanced_Accuracy\": balanced_accuracy_score(\n",
        "        y_test, rf_predictions\n",
        "    ),\n",
        "    \"FPR\": rf_fpr,\n",
        "    \"Training_Time_Seconds\": rf_training_time,\n",
        "    \"Inference_Time_Seconds\": rf_inference_time,\n",
        "    \"Parameters\": sum(\n",
        "        tree.tree_.node_count for tree in rf_model.estimators_\n",
        "    )\n",
        "}\n",
        "\n",
        "print(\"\\nRANDOM FOREST RESULTS\")\n",
        "\n",
        "for key, value in rf_results.items():\n",
        "    print(f\"{key}: {value}\")\n",
        "\n",
        "print(\"\\nConfusion Matrix:\")\n",
