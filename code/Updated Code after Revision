        "    \"bruteforce\": os.path.join(base, \"attack_data\", \"bruteforce\"),\n",
        "    \"ddos\": os.path.join(base, \"attack_data\", \"ddos\"),\n",
        "    \"dos\": os.path.join(base, \"attack_data\", \"dos\"),\n",
        "    \"malware\": os.path.join(base, \"attack_data\", \"malware\"),\n",
        "    \"mitm\": os.path.join(base, \"attack_data\", \"mitm\"),\n",
        "    \"recon\": os.path.join(base, \"attack_data\", \"recon\"),\n",
        "    \"web\": os.path.join(base, \"attack_data\", \"web\")\n",
        "}\n",
        "\n",
        "results = []\n",
        "\n",
        "for category, folder in folders.items():\n",
        "    files = [\n",
        "        os.path.join(root, f)\n",
        "        for root, dirs, filenames in os.walk(folder)\n",
        "        for f in filenames if f.endswith(\".json\")\n",
        "    ]\n",
        "\n",
        "    for path in files:\n",
        "        timestamps = []\n",
        "        count = 0\n",
        "\n",
