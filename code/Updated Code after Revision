        "# CELL 9: Uniform Sampling Across All CICIoT2023 Files\n",
        "\n",
        "import pandas as pd\n",
        "import numpy as np\n",
        "from pathlib import Path\n",
        "\n",
        "MAX_SAMPLE_PER_FILE = 12000\n",
        "CHUNK_SIZE = 100000\n",
        "rng = np.random.default_rng(42)\n",
        "\n",
        "sampled_frames = []\n",
        "sampling_summary = []\n",
        "\n",
        "train_folder = Path(DATASET_PATHS[\"train\"])\n",
        "all_csv_files = sorted(train_folder.rglob(\"*.csv\"))\n",
        "\n",
        "print(\"Total CSV files:\", len(all_csv_files))\n",
        "\n",
        "for file_index, file_path in enumerate(all_csv_files, 1):\n",
        "\n",
        "    reservoir = pd.DataFrame()\n",
        "    total_rows = 0\n",
        "\n",
        "    try:\n",
        "        for chunk in pd.read_csv(\n",
        "            file_path,\n",
        "            chunksize=CHUNK_SIZE,\n",
        "            low_memory=False\n",
        "        ):\n",
        "\n",
        "            chunk.columns = chunk.columns.astype(str).str.strip()\n",
        "            total_rows += len(chunk)\n",
        "\n",
        "            # Random priorities provide uniform sampling\n",
        "            chunk[\"_random_key\"] = rng.random(len(chunk))\n",
        "\n",
        "            if not reservoir.empty:\n",
        "                combined = pd.concat(\n",
        "                    [reservoir, chunk],\n",
        "                    ignore_index=True\n",
        "                )\n",
        "            else:\n",
        "                combined = chunk\n",
        "\n",
        "            reservoir = (\n",
        "                combined.nsmallest(\n",
        "                    MAX_SAMPLE_PER_FILE,\n",
        "                    \"_random_key\"\n",
        "                )\n",
        "                .reset_index(drop=True)\n",
        "            )\n",
        "\n",
        "        reservoir = reservoir.drop(columns=[\"_random_key\"])\n",
        "        reservoir[\"_source_file\"] = file_path.name\n",
        "\n",
        "        sampled_frames.append(reservoir)\n",
        "\n",
        "        sampling_summary.append({\n",
        "            \"file\": file_path.name,\n",
        "            \"total_rows\": total_rows,\n",
        "            \"sampled_rows\": len(reservoir)\n",
        "        })\n",
        "\n",
        "        print(\n",
        "            f\"{file_index}/{len(all_csv_files)} | \"\n",
        "            f\"{file_path.name} | \"\n",
        "            f\"Total: {total_rows:,} | \"\n",
        "            f\"Sampled: {len(reservoir):,}\"\n",
        "        )\n",
        "\n",
        "    except Exception as e:\n",
        "        print(\"ERROR:\", file_path.name, str(e)[:200])\n",
        "\n",
        "# Combine all sampled files\n",
        "train_raw = pd.concat(sampled_frames, ignore_index=True)\n",
        "\n",
        "# Recreate binary labels\n",
        "train_raw[\"binary_label\"] = (\n",
        "    train_raw[\"label\"]\n",
        "    .astype(str)\n",
        "    .str.strip()\n",
        "    .str.lower()\n",
        "    .ne(\"benigntraffic\")\n",
        "    .astype(int)\n",
        ")\n",
        "\n",
        "sampling_df = pd.DataFrame(sampling_summary)\n",
        "\n",
        "sampling_df.to_csv(\n",
        "    OUTPUT_DIR / \"all_file_sampling_summary.csv\",\n",
        "    index=False\n",
        ")\n",
        "\n",
        "train_raw.to_csv(\n",
        "    OUTPUT_DIR / \"CICIoT2023_representative_sample.csv\",\n",
        "    index=False\n",
        ")\n",
        "\n",
        "print(\"\\n\" + \"=\" * 65)\n",
        "print(\"REPRESENTATIVE SAMPLING COMPLETED\")\n",
        "print(\"=\" * 65)\n",
        "\n",
        "print(\"Total sampled records:\", len(train_raw))\n",
        "print(\"Source files represented:\", train_raw[\"_source_file\"].nunique())\n",
        "\n",
        "print(\"\\nBinary class distribution:\")\n",
        "print(train_raw[\"binary_label\"].value_counts())\n",
        "\n",
        "print(\"\\nBinary class percentages:\")\n",
        "print(\n",
        "    (train_raw[\"binary_label\"].value_counts(normalize=True) * 100)\n",
        "    .round(2)\n",
        ")\n",
        "\n",
        "print(\"\\nSource-wise class distribution:\")\n",
        "display(\n",
        "    pd.crosstab(\n",
        "        train_raw[\"_source_file\"],\n",
        "        train_raw[\"binary_label\"]\n",
        "    )\n",
        ")"
