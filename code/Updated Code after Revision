        "# CELL 11: Paired Statistical Tests\n",
        "\n",
        "import pandas as pd\n",
        "import numpy as np\n",
        "from scipy.stats import ttest_rel, wilcoxon\n",
        "\n",
        "comparisons = [\n",
        "    (\"Hybrid_CNN_Transformer\", \"CNN\"),\n",
        "    (\"Hybrid_CNN_Transformer\", \"Transformer\")\n",
        "]\n",
        "\n",
        "statistical_results = []\n",
        "\n",
        "for model_a, model_b in comparisons:\n",
        "\n",
        "    a = (\n",
        "        repeated_df[repeated_df[\"Model\"] == model_a]\n",
        "        .sort_values(\"Seed\")[\"F1\"]\n",
        "        .to_numpy()\n",
        "    )\n",
        "\n",
        "    b = (\n",
        "        repeated_df[repeated_df[\"Model\"] == model_b]\n",
        "        .sort_values(\"Seed\")[\"F1\"]\n",
        "        .to_numpy()\n",
        "    )\n",
        "\n",
        "    differences = a - b\n",
        "\n",
        "    t_stat, t_p = ttest_rel(a, b)\n",
        "\n",
        "    # Wilcoxon requires non-zero differences\n",
        "    if np.allclose(differences, 0):\n",
        "        w_stat, w_p = np.nan, np.nan\n",
        "    else:\n",
        "        w_stat, w_p = wilcoxon(\n",
        "            a, b,\n",
        "            alternative=\"two-sided\",\n",
        "            zero_method=\"wilcox\"\n",
        "        )\n",
        "\n",
        "    statistical_results.append({\n",
        "        \"Comparison\": f\"{model_a} vs {model_b}\",\n",
        "        \"Mean_F1_Difference\": differences.mean(),\n",
        "        \"SD_of_Difference\": differences.std(ddof=1),\n",
        "        \"Paired_t_statistic\": t_stat,\n",
        "        \"Paired_t_p_value\": t_p,\n",
        "        \"Wilcoxon_statistic\": w_stat,\n",
        "        \"Wilcoxon_p_value\": w_p\n",
        "    })\n",
        "\n",
        "stats_df = pd.DataFrame(statistical_results)\n",
        "\n",
        "display(stats_df)\n",
        "\n",
        "stats_df.to_csv(\n",
        "    OUTPUT_DIR / \"Paired_Statistical_Tests.csv\",\n",
        "    index=False\n",
        ")\n",
        "\n",
        "print(\"Paired statistical test results saved.\")"
      ],
