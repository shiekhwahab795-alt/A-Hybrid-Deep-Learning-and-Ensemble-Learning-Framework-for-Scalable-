        "    model.eval()\n",
        "\n",
        "    with torch.no_grad():\n",
        "        logits = model(X_test_tensor)\n",
        "        probabilities = torch.softmax(logits, dim=1).cpu().numpy()\n",
        "\n",
        "    neural_probabilities[model_name] = probabilities\n",
        "\n",
        "# Random Forest probabilities\n",
        "rf_prob = rf_model.predict_proba(X_test_scaled)\n",
