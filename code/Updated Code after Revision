        "\n",
        "# STEP 7: Feature-group ablation study\n",
        "\n",
        "import pandas as pd\n",
        "import numpy as np\n",
        "import time\n",
        "\n",
        "from sklearn.base import clone\n",
        "from sklearn.metrics import accuracy_score, f1_score\n",
        "from sklearn.compose import ColumnTransformer\n",
        "from sklearn.pipeline import Pipeline\n",
        "from sklearn.impute import SimpleImputer\n",
        "from sklearn.preprocessing import OneHotEncoder\n",
        "from sklearn.ensemble import RandomForestClassifier\n",
        "\n",
        "feature_groups = {\n",
        "    \"Numeric_only\": [\"message_numeric\"],\n",
        "    \"Arrays_only\": [\"array_1\", \"array_2\", \"array_3\"],\n",
        "    \"Categorical_only\": [\"value_type\", \"message_type\", \"application\"],\n",
        "    \"All_features\": FEATURES\n",
        "}\n",
        "\n",
        "results = []\n",
        "\n",
        "for name, selected in feature_groups.items():\n",
        "\n",
        "    numeric = [c for c in selected if c in NUMERIC_FEATURES]\n",
        "    categorical = [c for c in selected if c in CATEGORICAL_FEATURES]\n",
        "\n",
        "    transformers = []\n",
        "\n",
        "    if numeric:\n",
        "        transformers.append((\n",
        "            \"num\",\n",
        "            SimpleImputer(strategy=\"median\"),\n",
        "            numeric\n",
        "        ))\n",
        "\n",
        "    if categorical:\n",
        "        transformers.append((\n",
        "            \"cat\",\n",
        "            Pipeline([\n",
        "                (\"imputer\", SimpleImputer(strategy=\"most_frequent\")),\n",
        "                (\"encoder\", OneHotEncoder(\n",
        "                    handle_unknown=\"ignore\",\n",
        "                    min_frequency=10\n",
        "                ))\n",
        "            ]),\n",
        "            categorical\n",
        "        ))\n",
        "\n",
        "    prep = ColumnTransformer(transformers)\n",
        "\n",
        "    experiment = Pipeline([\n",
        "        (\"preprocessing\", prep),\n",
        "        (\"classifier\", RandomForestClassifier(\n",
        "            n_estimators=100,\n",
        "            max_depth=20,\n",
        "            min_samples_leaf=2,\n",
        "            class_weight=\"balanced_subsample\",\n",
        "            random_state=42,\n",
        "            n_jobs=-1\n",
        "        ))\n",
        "    ])\n",
        "\n",
        "    start = time.time()\n",
        "    experiment.fit(X_train[selected], y_train)\n",
        "    train_seconds = time.time() - start\n",
        "\n",
        "    pred = experiment.predict(X_test[selected])\n",
        "\n",
        "    results.append({\n",
        "        \"Configuration\": name,\n",
        "        \"Accuracy\": accuracy_score(y_test, pred),\n",
        "        \"Macro_F1\": f1_score(\n",
        "            y_test, pred, average=\"macro\", zero_division=0\n",
        "        ),\n",
        "        \"Weighted_F1\": f1_score(\n",
        "            y_test, pred, average=\"weighted\", zero_division=0\n",
        "        ),\n",
        "        \"Training_seconds\": train_seconds\n",
        "    })\n",
        "\n",
        "    print(name, \"completed\")\n",
        "\n",
        "ablation_df = pd.DataFrame(results)\n",
        "print(\"\\nABLATION RESULTS\")\n",
