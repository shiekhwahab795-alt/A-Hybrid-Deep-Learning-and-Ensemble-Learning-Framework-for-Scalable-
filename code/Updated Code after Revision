        "# CELL 6: Semantic Feature Distribution Audit\n",
        "\n",
        "import pandas as pd\n",
        "import numpy as np\n",
        "\n",
        "feature_pairs = {\n",
        "    \"flow_duration\": (\"flow_duration\", \"Flow Duration\"),\n",
        "    \"fin_flag\": (\"fin_flag_number\", \"FIN Flag Cnt\"),\n",
        "    \"syn_flag\": (\"syn_flag_number\", \"SYN Flag Cnt\"),\n",
        "    \"rst_flag\": (\"rst_flag_number\", \"RST Flag Cnt\"),\n",
        "    \"psh_flag\": (\"psh_flag_number\", \"PSH Flag Cnt\"),\n",
        "    \"ack_flag\": (\"ack_flag_number\", \"ACK Flag Cnt\"),\n",
        "    \"ece_flag\": (\"ece_flag_number\", \"ECE Flag Cnt\"),\n",
        "    \"urg_flag\": (\"urg_count\", \"URG Flag Cnt\"),\n",
        "    \"packet_size\": (\"Tot size\", \"Pkt Size Avg\"),\n",
        "}\n",
        "\n",
        "audit_rows = []\n",
        "\n",
        "for feature_name, (train_col, ext_col) in feature_pairs.items():\n",
        "\n",
        "    if train_col not in train_raw.columns:\n",
        "        continue\n",
        "\n",
        "    if ext_col not in ext2018_raw.columns:\n",
        "        continue\n",
        "\n",
        "    train_values = pd.to_numeric(\n",
        "        train_raw[train_col], errors=\"coerce\"\n",
        "    )\n",
        "\n",
        "    ext_values = pd.to_numeric(\n",
        "        ext2018_raw[ext_col], errors=\"coerce\"\n",
        "    )\n",
        "\n",
        "    audit_rows.append({\n",
        "        \"Feature\": feature_name,\n",
        "        \"Training_Column\": train_col,\n",
        "        \"External_Column\": ext_col,\n",
        "        \"Train_Mean\": train_values.mean(),\n",
        "        \"External_Mean\": ext_values.mean(),\n",
        "        \"Train_Std\": train_values.std(),\n",
        "        \"External_Std\": ext_values.std(),\n",
        "        \"Train_Missing\": train_values.isna().sum(),\n",
        "        \"External_Missing\": ext_values.isna().sum(),\n",
        "        \"Train_Infinite\": np.isinf(train_values).sum(),\n",
        "        \"External_Infinite\": np.isinf(ext_values).sum()\n",
        "    })\n",
        "\n",
        "audit_df = pd.DataFrame(audit_rows)\n",
