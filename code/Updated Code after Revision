        "\n",
        "verified_df.to_csv(\n",
        "    E / \"Independently_Verified_Model_Metrics.csv\",\n",
        "    index=False\n",
        ")\n",
        "\n",
        "print(\"\\nAll models use identical actual labels.\")\n",
        "print(\"Verified results saved successfully.\")"
