        "# 3. Discover CSV files and inspect dataset schemas\n",
        "def csv_files(folder):\n",
        "    if not folder.exists(): return []\n",
        "    return sorted([Path(p) for p in glob.glob(str(folder/'**'/'*.csv'), recursive=True)])\n",
        "\n",
        "def read_dataset(folder, tag):\n",
        "    files = csv_files(folder)\n",
        "    if not files: raise FileNotFoundError(f'No CSV files found under {folder}')\n",
        "    frames=[]\n",
        "    for fp in files:\n",
        "        try:\n",
        "            d=pd.read_csv(fp, nrows=MAX_ROWS_PER_FILE, low_memory=False)\n",
        "            if len(d):\n",
        "                d.columns=[str(c).strip() for c in d.columns]\n",
        "                d['_source_file']=fp.name\n",
        "                frames.append(d)\n",
        "        except Exception as e:\n",
        "            print('SKIP', fp.name, str(e)[:180])\n",
        "    if not frames: raise ValueError(f'No readable CSVs in {folder}')\n",
        "    out=pd.concat(frames, ignore_index=True, sort=False)\n",
        "    if len(out)>MAX_ROWS_PER_DATASET:\n",
        "        out=out.sample(MAX_ROWS_PER_DATASET, random_state=2026).reset_index(drop=True)\n",
        "    print(f'{tag}: files={len(files):,}, sampled_rows={len(out):,}, columns={len(out.columns)}')\n",
        "    return out\n",
        "\n",
        "raw = {k:read_dataset(p,k) for k,p in DATASET_PATHS.items()}\n",
        "\n",
        "def find_label_column(df):\n",
        "    low={str(c).strip().lower():c for c in df.columns}\n",
        "    for c in LABEL_CANDIDATES:\n",
        "        if c.strip().lower() in low: return low[c.strip().lower()]\n",
        "    # conservative fallback: exactly one column whose name contains label/class/attack\n",
        "    cand=[c for c in df.columns if any(t in str(c).lower() for t in ['label','class','attack'])]\n",
        "    if len(cand)==1: return cand[0]\n",
        "    raise ValueError(f'Cannot unambiguously identify label column. Candidate columns: {cand}. Set LABEL_COLS manually.')\n",
        "\n",
        "LABEL_COLS={k:find_label_column(v) for k,v in raw.items()}\n",
