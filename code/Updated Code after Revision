        "# CELL 7: CICIoT2023 Binary Label and Data Quality Audit\n",
        "\n",
        "import pandas as pd\n",
        "import numpy as np\n",
        "\n",
        "# Work on a copy\n",
        "train_audit = train_raw.copy()\n",
        "\n",
        "# Binary labels: Benign = 0, Attack = 1\n",
        "train_audit[\"binary_label\"] = (\n",
        "    train_audit[\"label\"]\n",
        "    .astype(str)\n",
        "    .str.strip()\n",
        "    .str.lower()\n",
        "    .ne(\"benigntraffic\")\n",
        "    .astype(int)\n",
        ")\n",
        "\n",
        "# Feature columns\n",
        "feature_cols = [\n",
        "    c for c in train_audit.columns\n",
        "    if c not in [\"label\", \"Label\", \"_source_file\", \"binary_label\"]\n",
        "]\n",
        "\n",
        "# Numeric conversion\n",
        "X_audit = train_audit[feature_cols].apply(\n",
        "    pd.to_numeric, errors=\"coerce\"\n",
        ")\n",
        "\n",
        "# Quality checks\n",
        "print(\"DATA SHAPE:\", train_audit.shape)\n",
        "print(\"FEATURE COUNT:\", len(feature_cols))\n",
        "\n",
        "print(\"\\nBINARY CLASS DISTRIBUTION:\")\n",
        "print(train_audit[\"binary_label\"].value_counts().sort_index())\n",
        "\n",
        "print(\"\\nCLASS PROPORTIONS:\")\n",
        "print(\n",
        "    train_audit[\"binary_label\"]\n",
        "    .value_counts(normalize=True)\n",
        "    .sort_index()\n",
        "    .round(4)\n",
        ")\n",
        "\n",
        "print(\"\\nMISSING VALUES:\", int(X_audit.isna().sum().sum()))\n",
        "print(\n",
