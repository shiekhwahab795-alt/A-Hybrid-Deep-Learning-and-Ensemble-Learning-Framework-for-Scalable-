        "# CELL 5: Feature Compatibility Audit\n",
        "\n",
        "import pandas as pd\n",
        "import numpy as np\n",
        "\n",
        "# Exclude labels and metadata\n",
        "train_features = [\n",
        "    c for c in train_raw.columns\n",
        "    if c not in [\"label\", \"Label\", \"_source_file\"]\n",
        "]\n",
        "\n",
        "external_features = [\n",
        "    c for c in ext2018_raw.columns\n",
        "    if c not in [\"label\", \"Label\", \"_source_file\", \"Timestamp\"]\n",
        "]\n",
        "\n",
        "print(\"=\" * 80)\n",
        "print(\"CICIoT2023 FEATURES\")\n",
        "print(\"=\" * 80)\n",
        "\n",
        "for i, feature in enumerate(train_features, 1):\n",
        "    print(f\"{i}. {feature}\")\n",
        "\n",
        "print(\"\\n\" + \"=\" * 80)\n",
        "print(\"CIC 2018 FEATURES\")\n",
        "print(\"=\" * 80)\n",
        "\n",
        "for i, feature in enumerate(external_features, 1):\n",
        "    print(f\"{i}. {feature}\")\n",
        "\n",
        "# Save feature lists for inspection\n",
        "feature_audit = pd.DataFrame({\n",
        "    \"CICIoT2023_Features\": pd.Series(train_features),\n",
        "    \"CIC_2018_Features\": pd.Series(external_features)\n",
        "})\n",
        "\n",
        "feature_audit.to_csv(\n",
        "    OUTPUT_DIR / \"feature_compatibility_audit.csv\",\n",
        "    index=False\n",
        ")\n",
        "\n",
        "print(\"\\nFeature audit saved successfully.\")\n",
